{
  "workdir": "/root/Desktop/selfhostllm",
  "binary": "engines/llamacpp/build/bin/llama-server",
  "model": "models/gguf/qwen36-35b-heretic/heretic-Q3_K_M.gguf",
  "mmproj": "models/gguf/qwen36-35b-heretic/mmproj-BF16.gguf",
  "port": 8081,
  "startup_timeout": 180,
  "runs": 2,
  "base_args": [
    "-ngl", "99", "--split-mode", "layer",
    "-fa", "on", "-ctk", "q4_0", "-ctv", "q4_0",
    "-c", "65536", "--parallel", "1", "--cache-reuse", "256",
    "--no-mmproj-offload", "--jinja",
    "--temp", "1.0", "--top-p", "0.95", "--top-k", "20",
    "-a", "heretic-qwen36-35b"
  ],
  "variants": [
    {"name": "mtp2-ub128", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "2", "-ub", "128"]},
    {"name": "mtp2-ub512", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "2", "-ub", "512"]},
    {"name": "mtp2-cpu-sampling", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "2", "-ub", "256", "--no-spec-draft-backend-sampling"]},
    {"name": "mtp2-pmin20", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "2", "-ub", "256", "--spec-draft-p-min", "0.20"]},
    {"name": "mtp8-ub128", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "8", "-ub", "128"]},
    {"name": "mtp8-ub512", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "8", "-ub", "512"]},
    {"name": "mtp8-cpu-sampling", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "8", "-ub", "256", "--no-spec-draft-backend-sampling"]},
    {"name": "mtp8-pmin20", "args": ["--spec-type", "draft-mtp", "--spec-draft-n-max", "8", "-ub", "256", "--spec-draft-p-min", "0.20"]}
  ]
}
