[Unit]
Description=gliccOps frontend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Desktop/gpu-optimized/frontend
Environment=FRONTEND_DB=/root/Desktop/gpu-optimized/frontend/data/gliccops.db
ExecStart=/root/Desktop/gpu-optimized/frontend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8090 --workers 1
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
