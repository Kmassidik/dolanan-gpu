FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
COPY app.py ./

EXPOSE 8090

CMD ["uvicorn", "api.main:app", "--host", "127.0.0.1", "--port", "8090", "--workers", "1"]
